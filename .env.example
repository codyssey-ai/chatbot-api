# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있으므로 저장소에 올라가지 않는다.

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# MODEL_NAME 은 기존 호환용 설정이다. 새 코드에서는 아래 OPENAI_MODEL_NAME 을 쓴다.
MODEL_NAME=openai:gpt-4.1-mini
OPENAI_MODEL_NAME=gpt-4.1-mini

# Gemini는 기본 모델이 아니다. 요약 모델을 바꾸거나 OpenAI 폴백을 사용할 때만 필요하다.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# main · summary 모두 기본값은 openai다. 필요할 때만 gemini로 바꾼다.
MAIN_MODEL_PROVIDER=openai
SUMMARY_MODEL_PROVIDER=openai

# 공급자별 단일 HTTP 호출 제한과 전체 Agent 호출 제한.
OPENAI_TIMEOUT_SECONDS=18
GEMINI_TIMEOUT_SECONDS=20
AI_TIMEOUT_SECONDS=60

# 요약 미들웨어. 대화가 TRIGGER 토큰을 넘으면 KEEP 토큰만 남기고 압축한다.
SUMMARY_TRIGGER_TOKENS=8000
SUMMARY_KEEP_TOKENS=4000

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Dashboard → Project Settings → Database → Connection string
# 반드시 Connection Pooler 의 Session 모드(5432)를 사용한다.
DATABASE_URL=

# Dashboard → Settings → API Keys
SUPABASE_URL=
# Publishable key (구버전 표기는 anon public)
SUPABASE_ANON_KEY=

# 선택값. 현재 코드에서는 사용하지 않으므로 비워 두어도 된다.
# 데이터 접근은 DATABASE_URL 로 직접 하고, 인증은 anon 키로 충분하다.
# 관리자 전용 작업이 필요해지면 Secret key 를 넣는다. 절대 클라이언트로 내보내지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# 애플리케이션
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
MAX_MESSAGE_LENGTH=2000

# 체크포인트 역직렬화 시 허용되지 않은 타입을 제한한다.
LANGGRAPH_STRICT_MSGPACK=true

# 로컬 개발은 HTTP 라 false, 배포(HTTPS)에서는 true 로 둔다.
COOKIE_SECURE=false
